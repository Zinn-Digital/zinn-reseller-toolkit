#, php-format
msgid "We could not reach Zinn Digital® from this server (%s). Copy the report above and open a ticket instead — nothing about your settings is wrong."
msgstr "Hatuwezi kufikia Zinn Digital® kutoka kwa seva hii (%s). Nakili ripoti iliyo hapo juu na ufungue tiketi badala yake — hakuna kosa lolote kwenye mipangilio yako."

#: includes/class-zinn-reseller-diagnostics.php:284
msgid "Sent. Zinn® support has your report and will reply by email."
msgstr "Imetumwa. Usaidizi wa Zinn® umepokea ripoti yako na utajibu kupitia barua pepe."

#. translators: %s: the support reference for the report just sent.
#: includes/class-zinn-reseller-diagnostics.php:287
#, php-format
msgid "Sent. Zinn® support has your report — reference %s — and will reply by email."
msgstr "Imetumwa. Usaidizi wa Zinn® umepokea ripoti yako — kumbukumbu %s — na utajibu kwa barua pepe."

#: includes/class-zinn-reseller-diagnostics.php:296
msgid "You have sent several reports in a short time. Wait a few minutes and try again — the earlier ones did arrive."
msgstr "Umetuma ripoti kadhaa kwa muda mfupi. Subiri dakika chache kisha ujaribu tena — ripoti za awali zilifika."

#: includes/class-zinn-reseller-diagnostics.php:303
msgid "Zinn Digital® could not accept the report just now — that is our end, not yours. Try again shortly, or copy the report above into a ticket."
msgstr "Zinn Digital® haikuweza kukubali ripoti sasa hivi — hilo ni tatizo la upande wetu, si wako. Jaribu tena hivi karibuni, au nakili ripoti iliyo hapo juu kwenye tiketi."

#. translators: %d: the HTTP status code the server returned.
#: includes/class-zinn-reseller-diagnostics.php:311
#, php-format
msgid "The report was refused (HTTP %d). Copy it above and open a ticket, quoting that number."
msgstr "Ripoti imekataliwa (HTTP %d). Inakili hapo juu na ufungue tiketi, ukitaja nambari hiyo."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
#: includes/class-zinn-reseller-promo.php:326
#: includes/class-zinn-reseller-promo.php:384
#, php-format
msgid "%s — guides and services"
msgstr "%s — miongozo na huduma"

#: includes/class-zinn-reseller-promo.php:341
msgid "User guides"
msgstr "Miongozo ya mtumiaji"

#. translators: %s: this plugin's name, e.g. "Zinn® Cache".
#: includes/class-zinn-reseller-promo.php:391
#, php-format
msgid "Read the %s user guide"
msgstr "Soma mwongozo wa mtumiaji wa %s"

