#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Uvezen je %d postavk. Zaporke i API ključevi se nikada ne izvoze, stoga ih unesite ponovno."
msgstr[1] "%d postavki je uvezeno. Zaporke i API ključevi nikada nisu uključeni u izvoz, stoga ih ponovo unesite."
msgstr[2] "%d postavki je uvezeno. Zaporke i API ključevi nikada nisu uključeni u izvoz, stoga ih ponovo unesite."

