#: includes/class-settings.php:199
msgid "API address"
msgstr "API adresa"

#: includes/class-settings.php:200
msgid "Leave this alone unless Zinn® support has asked you to change it."
msgstr "Ovo nemojte mijenjati osim ako vas podrška za Zinn® nije zatražila da to promijenite."

#: includes/class-settings.php:206
msgid "Control-panel address"
msgstr "Adresa upravljačke ploče"

#: includes/class-settings.php:207
msgid "Where the “My hosting” link sends your customers."
msgstr "Kamo poveznica „Moje udomljavanje” šalje vaše klijente."

#: includes/class-settings.php:223
msgid "Domain search"
msgstr "Pretraga domena"

