msgstr "Ta se datoteka nije mogła pročitati. Odaberite datoteku postavki izvezenu iz Zinn® dodatka."

#: includes/class-zinn-reseller-admin-ui.php:1182
msgid "That file is too large to be a settings export."
msgstr "Ta je datoteka prevelika da bi bila izvoz postavki."

#: includes/class-zinn-reseller-admin-ui.php:1195
