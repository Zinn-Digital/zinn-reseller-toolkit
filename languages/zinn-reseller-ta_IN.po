#. Plugin Name of the plugin
#: zinn-reseller.php
msgid "Zinn® Reseller Toolkit"
msgstr "Zinn® Reseller Toolkit"

#. Plugin URI of the plugin
#: zinn-reseller.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-reseller"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-reseller"

#. Description of the plugin
#: zinn-reseller.php
msgid "Sell Zinn Digital® hosting from your own WordPress site — WordPress, WooCommerce, agency, reseller, cloud and VPS hosting. Search and offer domains from your reseller account, sign your clients straight into their hosting panel, and provision hosting automatically when a WooCommerce order is paid."
msgstr "உங்கள் சொந்த WordPress தளத்திலிருந்து Zinn Digital® ஹோஸ்டிங்கை விற்பனை செய்யுங்கள் — WordPress, WooCommerce, ஏஜென்சி, மறுவிற்பனையாளர், கிளவுட் மற்றும் VPS ஹோஸ்டிங். உங்கள் மறுவிற்பனையாளர் கணக்கிலிருந்து டொமைன்களைத் தேடி வழங்குங்கள், உங்கள் வாடிக்கையாளர்களை அவர்களின் ஹோஸ்டிங் பேனலில் நேரடியாக உள்நுழையச் செய்யுங்கள், மற்றும் ஒரு WooCommerce ஆர்டருக்கான கட்டணம் செலுத்தப்பட்டதும் ஹோஸ்டிங்கைத் தானாகவே வழங்குங்கள்."

#. Author of the plugin
#: zinn-reseller.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-reseller.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#. translators: %d: HTTP status code returned by the hosting API.
#: includes/class-client.php:161
#, php-format
msgid "The hosting platform answered with status %d."
msgstr "ஹோஸ்டிங் தளம் %d எனும் நிலையுடன் பதிலளித்தது."

#: includes/class-domain-search.php:74
msgid "Find your domain name"
msgstr "உங்கள் டொமைன் பெயரைத் தேடுங்கள்"

#: includes/class-domain-search.php:75
msgid "Search"
msgstr "தேடு"

#: includes/class-domain-search.php:175
msgid "No extensions were checked for that name."
msgstr "அந்தப் பெயருக்கான எந்த நீட்டிப்புகளும் சரிபார்க்கப்படவில்லை."

#: includes/class-domain-search.php:214
msgid "Domain search is unavailable on this site at the moment."
msgstr "தற்போது இந்தத் தளத்தில் டொமைன் தேடல் கிடைக்கவில்லை."

#: includes/class-domain-search.php:215
msgid "We could not reach the domain registry just now. Please try again in a moment."
msgstr "எங்களால் தற்போது டொமைன் பதிவகத்தைத் தொடர்பு கொள்ள முடியவில்லை. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."

#: includes/class-domain-search.php:225
msgid "The API key is missing or no longer valid. Check it under Zinn Digital® → Reseller Toolkit."
msgstr "API விசை விடுபட்டுள்ளது அல்லது இனி செல்லுபடியாகாது. அதை Zinn Digital® → Reseller Toolkit என்பதன் கீழ் சரிபார்க்கவும்."

#: includes/class-domain-search.php:227
msgid "This API key does not carry the sites.view permission, which the domain search needs. Add it to the key in your reseller panel, or clear the key here to fall back to the public search."
msgstr "இந்த API விசை sites.view அனுமதியைக் கொண்டிருக்கவில்லை, இது டொமைன் தேடலுக்குத் தேவைப்படுகிறது. உங்கள் மறுவிற்பனையாளர் பேனலில் உள்ள விசையுடன் அதைச் சேர்க்கவும், அல்லது பொதுத் தேடலுக்கு மாற இங்கே விசையை அழிக்கவும்."

#: includes/class-domain-search.php:232
msgid "Only administrators see this:"
msgstr "நிர்வாகிகள் மட்டுமே இதைப் பார்க்க முடியும்:"

#: includes/class-domain-search.php:281
msgid "We could not check this one — try again"
msgstr "இதை எங்களால் சரிபார்க்க முடியவில்லை — மீண்டும் முயற்சிக்கவும்"

#: includes/class-domain-search.php:285
msgid "Already registered"
msgstr "ஏற்கனவே பதிவு செய்யப்பட்டுள்ளது"

#: includes/class-domain-search.php:323
msgid "Available — ask us for a price"
msgstr "கிடைக்கக்கூடியது — விலையை எங்களிடம் கேளுங்கள்"

#. translators: 1: price, 2: ISO currency code.
#: includes/class-domain-search.php:328
#, php-format
msgid "Available — %1$s %2$s for the first year"
msgstr "கிடைக்கிறது — முதல் ஆண்டிற்கு %1$s %2$s"

#: includes/class-domain-search.php:351
msgid "Register it"
msgstr "இதைப் பதிவுசெய்யுங்கள்"

#: includes/class-panel-link.php:65
msgid "Manage my hosting"
msgstr "எனது ஹோஸ்டிங்கை நிர்வகிக்கவும்"

#: includes/class-panel-link.php:87
msgid "Please sign in first."
msgstr "முதலில் உள்நுழையவும்."

#: includes/class-panel-link.php:94
msgid "This account is not linked to a hosting service yet."
msgstr "இந்தக் கணக்கு இன்னும் எந்த ஹோஸ்டிங் சேவையுடனும் இணைக்கப்படவில்லை."

#: includes/class-panel-link.php:104
msgid "The hosting platform did not return a sign-in link."
msgstr "ஹோஸ்டிங் தளம் உள்நுழைவு இணைப்பை வழங்கவில்லை."

