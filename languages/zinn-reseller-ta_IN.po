msgstr "“சரிபார்க்க முடியவில்லை” நிறம்"

#: includes/class-settings.php:333
msgid "Error colour"
msgstr "பிழை நிறம்"

#: includes/class-settings.php:337
msgid "Corner rounding"
msgstr "மூலை வளைவு"

#: includes/class-settings.php:341
