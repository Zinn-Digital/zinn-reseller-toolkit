msgstr "[zinn_domain_search] qisqa kodini kiriting"

#: includes/class-settings.php:225
msgid "Put the shortcode on any page to let visitors check a domain and buy it through you."
msgstr "Tashrif buyuruvchilarga domenni tekshirish va uni siz orqali sotib olish imkonini berish uchun qisqa kodni istalgan sahifaga joylashtiring."

#: includes/class-settings.php:231
msgid "Panel link"
msgstr "Panel havolasi"

