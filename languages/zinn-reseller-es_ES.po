#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d ajuste importado. Las contraseñas y las claves de API nunca se incluyen en una exportación, así que vuelve a introducirlas."
msgstr[1] "Se han importado %d ajustes. Las contraseñas y las claves de API nunca se incluyen en una exportación, así que vuelve a introducirlas."
msgstr[2] "Se han importado %d ajustes. Las contraseñas y las claves de API nunca se incluyen en una exportación, así que vuelve a introducirlas."

