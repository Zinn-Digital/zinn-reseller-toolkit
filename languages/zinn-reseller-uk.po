#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Імпортовано %d налаштування. Паролі та ключі API ніколи не включаються в експорт, тому введіть їх знову."
msgstr[1] "Імпортовано %d налаштувань. Паролі та ключі API ніколи не включаються в експорт, тому введіть їх знову."
msgstr[2] "Імпортовано %d налаштувань. Паролі та ключі API ніколи не включаються в експорт, тому введіть їх знову."

