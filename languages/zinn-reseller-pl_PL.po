msgstr "Ten plik nie jest eksportem ustawień Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-reseller-admin-ui.php:1203
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Plik ten został wyeksportowany z innej wtyczki (%s), więc jego import tutaj spowoduje zapisanie ustawień, których ta wtyczka nie obsługuje."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-reseller-admin-ui.php:1233
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "Zaimportowano %d ustawienie. Hasła i klucze API nigdy nie są eksportowane, dlatego należy wprowadzić je ponownie."
msgstr[1] "Zaimportowano ustawień: %d. Hasła i klucze API nigdy nie są uwzględniane w eksportach, dlatego należy wprowadzić je ponownie."
msgstr[2] "Zaimportowano ustawień: %d. Hasła i klucze API nigdy nie są uwzględniane w eksportach, dlatego należy wprowadzić je ponownie."

