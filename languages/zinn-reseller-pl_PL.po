#. Plugin Name of the plugin
#: zinn-reseller.php
msgid "Zinn® Reseller Toolkit"
msgstr "Zinn® Reseller Toolkit"

#. Plugin URI of the plugin
#: zinn-reseller.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-reseller"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-reseller"

#. Description of the plugin
#: zinn-reseller.php
msgid "Sell Zinn Digital® hosting from your own WordPress site — WordPress, WooCommerce, agency, reseller, cloud and VPS hosting. Search and offer domains from your reseller account, sign your clients straight into their hosting panel, and provision hosting automatically when a WooCommerce order is paid."
msgstr "Sprzedawaj hosting Zinn Digital® ze swojej własnej witryny WordPress — hosting WordPress, WooCommerce, agencyjny, resellerski, w chmurze i VPS. Wyszukuj i oferuj domeny ze swojego konta resellera, loguj swoich klientów bezpośrednio do ich panelu hostingowego i automatycznie uruchamiaj hosting, gdy zamówienie w WooCommerce zostanie opłacone."

#. Author of the plugin
#: zinn-reseller.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-reseller.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#. translators: %d: HTTP status code returned by the hosting API.
#: includes/class-client.php:161
#, php-format
msgid "The hosting platform answered with status %d."
msgstr "Platforma hostingowa odpowiedziała statusem %d."

#: includes/class-domain-search.php:74
msgid "Find your domain name"
msgstr "Znajdź swoją domenę"

#: includes/class-domain-search.php:75
msgid "Search"
msgstr "Szukaj"

#: includes/class-domain-search.php:175
msgid "No extensions were checked for that name."
msgstr "Nie sprawdzono żadnych rozszerzeń dla tej nazwy."

#: includes/class-domain-search.php:214
msgid "Domain search is unavailable on this site at the moment."
msgstr "Wyszukiwanie domen jest w tej chwili niedostępne na tej stronie."

#: includes/class-domain-search.php:215
msgid "We could not reach the domain registry just now. Please try again in a moment."
msgstr "Nie udało się teraz połączyć z rejestrem domen. Spróbuj ponownie za chwilę."

#: includes/class-domain-search.php:225
msgid "The API key is missing or no longer valid. Check it under Zinn Digital® → Reseller Toolkit."
msgstr "Klucz API jest brakujący lub przestał być ważny. Sprawdź go w sekcji Zinn Digital® → Reseller Toolkit."

#: includes/class-domain-search.php:227
msgid "This API key does not carry the sites.view permission, which the domain search needs. Add it to the key in your reseller panel, or clear the key here to fall back to the public search."
msgstr "Ten klucz API nie ma uprawnienia sites.view, które jest wymagane do wyszukiwania domen. Dodaj je do klucza w swoim panelu resellera lub wyczyść klucz tutaj, aby powrócić do wyszukiwania publicznego."

#: includes/class-domain-search.php:232
msgid "Only administrators see this:"
msgstr "Widoczne tylko dla administratorów:"

#: includes/class-domain-search.php:281
msgid "We could not check this one — try again"
msgstr "Nie udało się tego sprawdzić — spróbuj ponownie"

#: includes/class-domain-search.php:285
msgid "Already registered"
msgstr "Już zarejestrowano"

#: includes/class-domain-search.php:323
msgid "Available — ask us for a price"
msgstr "Dostępne — zapytaj nas o cenę"

