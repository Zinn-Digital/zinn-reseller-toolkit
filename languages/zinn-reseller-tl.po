msgstr "Hindi mabasa ang file na iyon. Pumili ng settings file na na-export mula sa isang Zinn® plugin."

#: includes/class-zinn-reseller-admin-ui.php:1265
msgid "That file is too large to be a settings export."
msgstr "Napakalaki ng file na iyon para maging pag-export ng mga setting."

#: includes/class-zinn-reseller-admin-ui.php:1278
msgid "That file is not a Zinn® settings export."
msgstr "Ang file na iyon ay hindi isang pag-export ng mga setting ng Zinn®."

#. translators: %s: the plugin slug the file was exported from.
#: includes/class-zinn-reseller-admin-ui.php:1286
#, php-format
msgid "That file was exported from a different plugin (%s), so importing it here would store settings this plugin does not understand."
msgstr "Na-export ang file na iyon mula sa ibang plugin (%s), kaya ang pag-import nito rito ay magse-save ng mga setting na hindi naiintindihan ng plugin na ito."

#. translators: %d: how many settings were imported.
#: includes/class-zinn-reseller-admin-ui.php:1316
#, php-format
msgid "%d setting imported. Passwords and API keys are never in an export, so enter those again."
msgid_plural "%d settings imported. Passwords and API keys are never in an export, so enter those again."
msgstr[0] "%d setting ang na-import. Hindi kailanman kasama sa export ang mga password at API key, kaya ilagay mo itong muli."
msgstr[1] "%d setting ang na-import. Ang mga password at API key ay hindi kailanman kasama sa pag-export, kaya ilagay mo ulit ang mga ito."

