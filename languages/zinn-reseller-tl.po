msgstr "Mga seksyon ng mga setting"

#: includes/class-zinn-reseller-admin-ui.php:788
msgid "Support"
msgstr "Suporta"

#: includes/class-zinn-reseller-admin-ui.php:846
msgid "Save changes"
msgstr "I-save ang mga pagbabago"

#: includes/class-zinn-reseller-admin-ui.php:875
msgid "Tools"
msgstr "Mga Tool"

#: includes/class-zinn-reseller-admin-ui.php:890
