msgstr "Ilagay ang shortcode sa anumang pahina para hayaang suriin ng mga bisita ang isang domain at bilhin ito sa pamamagitan mo."

#: includes/class-settings.php:203
msgid "Panel link"
msgstr "Link ng panel"

#: includes/class-settings.php:204
msgid "Show a “My hosting” link to signed-in customers"
msgstr "Magpakita ng link na “Aking hosting” sa mga naka-sign in na customer"

#: includes/class-settings.php:210
msgid "WooCommerce provisioning"
msgstr "Paglalaan ng WooCommerce"

#: includes/class-settings.php:211
