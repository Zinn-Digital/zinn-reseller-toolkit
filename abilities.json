{
  "$comment": "GENERATED by wp/tests/wp-integration/mcp_abilities.sh from the abilities a running site registers (Pro on). Do not edit: WRITE_REGISTRY=1 regenerates it, and the harness fails when this file differs from the site.",
  "plugin": "zinn-reseller",
  "category": "zinn-reseller",
  "mcp": {
    "http_endpoint": "/wp-json/zinn-reseller/v1/mcp",
    "stdio": "wp mcp-adapter serve --server=zinn-reseller --user=<login>",
    "auth": "a WordPress application password (HTTP) or --user (WP-CLI); the user needs the capability each ability names",
    "switch": "Settings: Allow AI agents (MCP), on by default"
  },
  "rest": {
    "list": "/wp-json/wp-abilities/v1/abilities?category=zinn-reseller",
    "run": "/wp-json/wp-abilities/v1/abilities/<name>/run  (GET with ?input= for read-only abilities, POST {\"input\": {...}} otherwise)"
  },
  "docs": {
    "user_guide": "https://zinndigital.com/wordpress-plugins/zinn-reseller/mcp",
    "developers": "https://zinndigital.com/wordpress-plugins/zinn-reseller/mcp-api"
  },
  "abilities": [
    {
      "name": "zinn-reseller/create-client",
      "label": "Create a client",
      "description": "Creates a client account under yours (name; default_currency, a three-letter code). Put them on a plan before their first site.",
      "edition": "free",
      "capability": "manage_options",
      "annotations": {
        "readonly": false,
        "destructive": false,
        "idempotent": false
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "default_currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "rest": {
        "method": "POST",
        "path": "/wp-json/wp-abilities/v1/abilities/zinn-reseller/create-client/run"
      },
      "mcp_tool": "zinn-reseller-create-client"
    },
    {
      "name": "zinn-reseller/create-site",
      "label": "Create a site for a client",
      "description": "Creates a hosted site for one of your clients (client_id, product_line, primary_domain). It is billed to your account at the client's plan, as from your shop.",
      "edition": "free",
      "capability": "manage_options",
      "annotations": {
        "readonly": false,
        "destructive": false,
        "idempotent": false
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "product_line": {
            "type": "string",
            "minLength": 1
          },
          "primary_domain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253
          }
        },
        "additionalProperties": false,
        "required": [
          "client_id",
          "product_line",
          "primary_domain"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "rest": {
        "method": "POST",
        "path": "/wp-json/wp-abilities/v1/abilities/zinn-reseller/create-site/run"
      },
      "mcp_tool": "zinn-reseller-create-site"
    },
    {
